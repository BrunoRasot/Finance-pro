# Reference only: this file is not loaded automatically.
# Runtime on Render: pooled connection with the dedicated application login.
DATABASE_URL=postgresql://APP_LOGIN:REPLACE_ME@ep-REPLACE-pooler.us-east-2.aws.neon.tech/finance_pro?sslmode=verify-full

# Local migrations/backups: direct connection with the migration administrator.
# Temporarily supply this value as DATABASE_URL when running Prisma migrations.
DIRECT_DATABASE_URL=postgresql://ADMIN_LOGIN:REPLACE_ME@ep-REPLACE.us-east-2.aws.neon.tech/finance_pro?sslmode=verify-full

# Authentication stays in the existing Supabase project.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
