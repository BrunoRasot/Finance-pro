[Unit]
Description=Finance Pro daily application backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=finance-pro
WorkingDirectory=/opt/finance-pro/apps/api
EnvironmentFile=/etc/finance-pro/backup.env
ExecStart=/usr/bin/node scripts/daily-backup.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups/finance-pro
