NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# Lista de orígenes exactos separados por comas. Sin rutas ni barra final.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=60

# pnpm db:setup genera DATABASE_URL local con una contraseña aleatoria.
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5433/finance_pro
# URL pública de tu proyecto Supabase, sin barra final. Requiere claves ES256 o RS256.
# SUPABASE_URL=https://PROJECT.supabase.co
