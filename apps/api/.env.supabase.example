# Copiar a .env.supabase y completar solo localmente.
# Supabase > Connect > Session pooler (puerto 5432).
# Codificar caracteres especiales de la contraseña en formato URL.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=verify-full
# Ruta del certificado CA público descargado desde Supabase (relativa a apps/api).
# SUPABASE_CA_CERT=certs/supabase-ca.crt
